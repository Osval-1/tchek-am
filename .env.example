# Local-dev placeholders only; never commit real secrets.
# S3_ACCESS_KEY/S3_SECRET_KEY must match docker/seaweedfs/s3.json for local dev.
DATABASE_URL=postgres://tchekam:tchekam@localhost:5432/tchekam
SECRET_KEY=insecure-local-dev-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=True

MESSAGING_CHANNEL=wasender
WASENDER_BASE_URL=https://www.wasenderapi.com/api
WASENDER_API_KEY=changeme
WASENDER_WEBHOOK_SECRET=changeme
WASENDER_BACKUP_API_KEY=changeme
WASENDER_BACKUP_WEBHOOK_SECRET=changeme
WASENDER_ACTIVE_SESSION=primary
# One OpenRouter key for all chat, image understanding and transcription.
OPENROUTER_API_KEY=
# openrouter (real API) or fake (offline)
AI_BACKEND=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_ENDPOINTS=together/us
OPENROUTER_TIMEOUT_SECONDS=30
SPEECH_BACKEND=openrouter
SPEECH_MODEL=openai/whisper-large-v3
SPEECH_MAX_AUDIO_BYTES=26214400
SPEECH_MAX_COST_MICROUSD=30000
AGENT_MAX_AUDIO_SECONDS=120
# serpapi (Google Lens) or fake (offline)
WEB_SEARCH_BACKEND=serpapi
SERPAPI_API_KEY=changeme
# Web image searches per user per local day (photo checks; report images are exempt)
WEB_SEARCH_PER_USER_DAY=5
# Provider calls per local month across everything; cache hits are free
WEB_SEARCH_MONTHLY_BUDGET=1000

S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=tchekam-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
OBJECT_STORE_BACKEND=s3
# Set true in prod; local SeaweedFS rejects SSE requests.
S3_SSE=False
TASKS_EAGER=False

SENTRY_DSN=
FIELD_ENCRYPTION_KEY=changeme
# HMAC secret for pseudonymous reporter keys; set once in prod and never rotate.
REPORTER_KEY_SECRET=changeme
TERMS_URL=http://localhost:8000/terms
# Shown to reporters under "next steps"; leave empty to omit
HELP_URL=
# Hours after a user's last message during which we may message them first-hand (ADR-011)
REPLY_WINDOW_HOURS=24

# Max checks per user per local day (all kinds)
CHECKS_PER_DAY=30

# Reports a user may submit per local day (any status except withdrawn)
REPORTS_PER_DAY=3
# Review time quoted to reporters, in hours
REVIEW_ETA_HOURS=24

# Reverse proxies in front of Django (Render: 1, verify at deploy). 0 ignores X-Forwarded-For;
# never use 0 behind a proxy, or every client shares one IP (audit logs, login throttling).
TRUSTED_PROXY_COUNT=0

# Conversational agent: production traffic is opt-in; the $1 approval covered synthetic tests.
AGENT_ENABLED=False
AGENT_VISION_ENABLED=False
AGENT_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017
AGENT_VISION_MODEL=deepseek/deepseek-v4.1-flash-1017
AGENT_LANGUAGES=fr,en
AGENT_ROLE_POLICIES={}
# Tested role configuration (no separate approval/verification booleans):
# {"chat":{"endpoints":["together/us"],"max_cost_microusd":30000,"temperature":0,"reasoning":{"effort":"low","exclude":true}},"vision":{"endpoints":["together/us"],"max_cost_microusd":30000,"temperature":0,"reasoning":{"effort":"none","enabled":false}}}
# Separate random HMAC keys; retain older key versions for the 7-day history window.
AGENT_MEMORY_KEY_VERSION=v1
AGENT_MEMORY_KEYS={}
AGENT_OPERATION_KEY=
AGENT_DAILY_BUDGET_MICROUSD=0
AGENT_MONTHLY_BUDGET_MICROUSD=0
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_PENDING=3
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_CONTEXT_BYTES=32000
AGENT_DEADLINE_SECONDS=60
AGENT_REQUEST_TIMEOUT=20
AGENT_HISTORY_MESSAGES=20
AGENT_HISTORY_HOURS=24
AGENT_HISTORY_TOKENS=6000
# Synthetic local traces only; production trace retention/selective deletion gates are pending.
AGENT_TRACE_SYNTHETIC=False
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_MEDIA_UPLOAD_ENABLED=False
